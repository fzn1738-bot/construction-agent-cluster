      "fields": [
        "From",
        "Subject",
        "Result",
        "When"
      ]
    },
    {
      "title": "Events by source",
      "kind": "bar",
      "fields": [
        "Events"
      ]
    },
    {
      "title": "Latest events",
      "kind": "table",
      "fields": [
        "Source",
        "Result",
        "What",
        "When"
      ]
    },
    {
      "title": "Workflow runs, last 24 hours",
      "kind": "line",
      "fields": [
        "Runs"
      ]
    },
    {
      "title": "Workflow results",
      "kind": "bar",
      "fields": [
        "Runs"
      ]
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Run every outcome now",
      "description": "Scan the site folder, sync FTP and check the inbox once, for every outcome that is set up",
      "input": null,
      "adminOnly": true
    },
    {
      "id": "scan-folders",
      "label": "Scan site folders",
      "description": "Look for new drawings and documents now",
      "input": null
    },
    {
      "id": "sync-ftp",
      "label": "Sync FTP now",
      "description": "Mirror files with the contractor FTP server now",
      "input": null
    },
    {
      "id": "check-inbox",
      "label": "Check inbox now",
      "description": "Triage new project emails now",
      "input": null
    },
    {
      "id": "check-database",
      "label": "Check the record",
      "description": "Verify the activity record is intact",
      "input": null
    },
    {
      "id": "run-due-workflows",
      "label": "Run due workflows now",
      "description": "Start every workflow whose schedule is due",
      "input": null,
      "adminOnly": true
    },
    {
      "id": "stop-all-runs",
      "label": "Stop all running workflows",
      "description": "Halt every workflow that is running right now",
      "input": null
    }
  ],
  "reports": [],
  "panes": [
    {
      "id": "documents",
      "title": "Site documents",
      "summary": "Drawings and documents filed the moment they land in the watched site folder.",
      "feature": "F2",
      "metrics": [
        "docsFiled",
        "docsWaiting"
      ],
      "panels": [
        "Arrivals, last 24 hours",
        "Recent arrivals"
      ],
      "actions": [
        "scan-folders"
      ],
      "client": true,
      "layout": "split",
      "columns": [
        "File",
        "Folder",
        "Event",
        "When"
      ],
      "recordsTitle": "Arrivals"
    },
    {
      "id": "transfers",
      "title": "Contractor file transfers",
      "summary": "Files mirrored between site and the contractor's FTP server, with every failure shown.",
      "feature": "F2",
      "metrics": [
        "ftpTransfers",
        "ftpFailed"
      ],
      "panels": [
        "Transfers, last 24 hours",
        "Transfer history"
      ],
      "actions": [
        "sync-ftp"
      ],
      "client": true,
      "layout": "focus",
      "columns": [
        "File",
        "Direction",
        "Result",
        "When"
      ],
      "recordsTitle": "Transfers"
    },
    {
      "id": "inbox",
      "title": "Project inbox",
      "summary": "RFIs and invoices picked out of the project mailbox by your triage rules.",
      "feature": "F2",
      "metrics": [
        "emailsProcessed",
        "emailBacklog"
      ],
      "panels": [
        "Triage by rule",
        "Recent messages"
      ],
      "actions": [
        "check-inbox"
      ],
      "client": true,
      "layout": "split",
      "columns": [
        "From",
        "Subject",
        "Result",
        "When"
      ],
      "recordsTitle": "Messages"
    },
    {
      "id": "activity-log",
      "title": "Activity record",
      "summary": "A permanent, filterable record of everything the agent has done, exportable on demand.",
      "feature": "F2",
      "metrics": [
        "logRows",
        "dbIntegrity"
      ],
      "panels": [
        "Events by source",
        "Latest events"
      ],
      "actions": [
        "check-database"
      ],
      "client": true,
      "layout": "grid",
      "columns": [
        "Source",
        "Result",
        "What",
        "When"
      ],
      "recordsTitle": "Events"
    },
    {
      "id": "rpa-record",
      "title": "Record a workflow",
      "summary": "Watch a task being done once, with a screenshot for every click, typed value and page change, and turn it into a workflow.",
      "feature": "F1",
      "metrics": [
        "wfRecorded"
      ],
      "panels": [],
      "actions": [],
      "client": true,
      "layout": "split",
      "columns": [
        "Step",
        "Action",
        "Target",
        "Screenshot"
      ],
      "recordsTitle": "Captured steps"
    },
    {
      "id": "rpa-workflows",
      "title": "Workflows",
      "summary": "Each customer's trained workflows: rename and reorder steps, add variables and approval checkpoints, schedule them or start them from a trigger.",
      "feature": "F5",
      "metrics": [
        "wfCount",
        "wfScheduled"
      ],
      "panels": [],
      "actions": [],
      "client": true,
      "layout": "split",
      "columns": [
        "Workflow",
        "Steps",
        "Schedule",
        "Last run"
      ],
      "recordsTitle": "Workflows"
    },
    {
      "id": "rpa-run",
      "title": "Run a workflow",
      "summary": "Replay a workflow and watch every step live with its screenshot, pass or fail, approvals and a stop button.",
      "feature": "F6",
      "metrics": [
        "wfWaiting"
      ],
      "panels": [],
      "actions": [
        "run-due-workflows",
        "stop-all-runs"
      ],
      "client": true,
      "layout": "focus",
      "columns": [
        "Step",
        "State",
        "Time",
        "Screenshot"
      ],
      "recordsTitle": "Steps"
    },
    {
      "id": "rpa-history",
      "title": "Run history",
      "summary": "Every run with its log, errors and screenshots, and a way to continue from the step that failed.",
      "feature": "F8",
      "metrics": [
        "wfRuns",
        "wfSuccess",
        "wfAvg",
        "wfErrors"
      ],
      "panels": [
        "Workflow runs, last 24 hours",
        "Workflow results"
      ],
      "actions": [],
      "client": true,
      "layout": "grid",
      "columns": [
        "Workflow",
        "Result",
        "Started",
        "Time"
      ],
      "recordsTitle": "Runs"
    }
  ],
  "settings": [
    {
      "key": "watch_folder",
      "label": "Watched site folder",
      "type": "text",
      "group": "Site folder",
      "help": "Absolute path of the folder where site documents arrive."
    },
    {
      "key": "ftp_host",
      "label": "FTP host",
      "type": "text",
      "group": "Contractor FTP",
      "help": "e.g. ftp.contractor.example"
    },
    {
      "key": "ftp_port",
      "label": "FTP port",
      "type": "number",
      "default": 21,
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_user",
      "label": "FTP user",
      "type": "text",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_password",
      "label": "FTP password",
      "type": "secret",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_secure",
      "label": "FTP security",
      "type": "select",
      "options": [
        "none",
        "explicit",
        "implicit"
      ],
      "default": "explicit",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_remote_dir",
      "label": "FTP remote folder",
      "type": "text",
      "default": "/",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_local_dir",
      "label": "Local mirror folder",
      "type": "text",
      "group": "Contractor FTP",
      "help": "Where mirrored files are kept. Leave empty to use the dashboard data folder."
    },
    {
      "key": "ftp_direction",
      "label": "Sync direction",
      "type": "select",
      "options": [
        "download",
        "upload",
        "both"
      ],
      "default": "download",
      "group": "Contractor FTP"
    },
    {
      "key": "imap_host",
      "label": "Mailbox host (IMAP)",
      "type": "text",
      "group": "Project mailbox",
      "help": "e.g. imap.example.com"
    },
    {
      "key": "imap_port",
      "label": "Mailbox port",
      "type": "number",
      "default": 993,
      "group": "Project mailbox"
    },
    {
      "key": "imap_user",
      "label": "Mailbox user",
      "type": "text",
      "group": "Project mailbox"
    },
    {
      "key": "imap_password",
      "label": "Mailbox password",
      "type": "secret",
      "group": "Project mailbox"
    },
    {
      "key": "imap_secure",
      "label": "Use TLS",
      "type": "toggle",
      "default": true,
      "group": "Project mailbox"
    },
    {
      "key": "imap_mailbox",
      "label": "Mailbox folder",
      "type": "text",
      "default": "INBOX",
      "group": "Project mailbox"
    },
    {
      "key": "imap_rules",
      "label": "Triage rules",
      "type": "textarea",
      "group": "Project mailbox",
      "help": "One rule per line as name: subject keyword, e.g. rfi: RFI"
    },
    {
      "key": "staleAfterMin",
      "label": "Flag a monitor as stale after (min)",
      "type": "number",
      "default": 30,
      "group": "Monitoring"
    },
    {
      "key": "recentRows",
      "label": "Rows shown in recent lists",
      "type": "number",
      "default": 12,
      "group": "Monitoring"
    },
    {
      "key": "successTarget",
      "label": "Sync success target (%)",
      "type": "number",
      "default": 90,
      "group": "Monitoring"
    },
    {
      "key": "latencyWarnMs",
      "label": "Flag a service as slow above (ms)",
      "type": "number",
      "default": 1500,
      "group": "Monitoring"
    },
    {
      "key": "rpa_agent_url",
      "label": "Automation agent address",
      "type": "text",
      "group": "Workflow automation",
      "help": "Address of the desktop automation agent that performs clicks and typing, e.g. http://127.0.0.1:7788"
    },
    {
      "key": "rpa_agent_token",
      "label": "Automation agent token",
      "type": "secret",
      "group": "Workflow automation",
      "help": "Sent as a Bearer token with every request to the agent."
    },
    {
      "key": "rpa_login_user",
      "label": "Login used by workflows",
      "type": "secret",
      "group": "Workflow automation",
      "help": "Filled into steps that use {{login_user}}. Never shown to clients."
    },
    {
      "key": "rpa_login_password",
      "label": "Password used by workflows",
      "type": "secret",
      "group": "Workflow automation",
      "help": "Filled into steps that use {{login_password}}. Passwords typed while recording are never saved."
    },
    {
      "key": "rpa_step_delay_ms",
      "label": "Pause between steps (ms)",
      "type": "number",
      "default": 400,
      "group": "Workflow automation"
    },
    {
      "key": "rpa_max_retries",
      "label": "Retries for a failing step",
      "type": "number",
      "default": 1,
      "group": "Workflow automation",
      "help": "0 to 5."
    },
    {
      "key": "rpa_approval_minutes",
      "label": "Minutes to wait for an approval",
      "type": "number",
      "default": 30,
      "group": "Workflow automation"
    }
  ],
  "connections": [
    {
      "id": "folders",
      "name": "Site folder",
      "summary": "The local folder the agent watches for new site documents.",
      "docs": "",
      "required": true,
      "fields": [
        "watch_folder"
      ]
    },
    {
      "id": "ftp",
      "name": "Contractor FTP server",
      "summary": "FTP or FTPS server mirrored with the site.",
      "docs": "https://www.rfc-editor.org/rfc/rfc959",
      "required": true,
      "fields": [
        "ftp_host",
        "ftp_user",
        "ftp_password"
      ],
      "optional": [
        "ftp_port",
        "ftp_secure",
        "ftp_remote_dir",
        "ftp_local_dir",
        "ftp_direction"
      ]
    },
    {
      "id": "imap",
      "name": "Project mailbox (IMAP)",
      "summary": "The inbox the agent triages for RFIs and invoices.",
      "docs": "https://www.rfc-editor.org/rfc/rfc9051",
      "required": true,
      "fields": [
        "imap_host",
        "imap_user",
        "imap_password"
      ],
      "optional": [
        "imap_port",
        "imap_secure",
        "imap_mailbox",
        "imap_rules"
      ]
    },
    {
      "id": "rpa-agent",
      "name": "Desktop automation agent",
      "summary": "Performs recorded clicks and typing on the machine where the work is done, takes the screenshots and reports each step back.",
      "docs": "",
      "required": false,
      "fields": [
        "rpa_agent_url",
        "rpa_agent_token"
      ],
      "optional": [
        "rpa_login_user",
        "rpa_login_password",
        "rpa_step_delay_ms",
        "rpa_max_retries",
        "rpa_approval_minutes"
      ]
    }
  ],
  "repo": "construction-agent-cluster",
  "port": 4102
}
