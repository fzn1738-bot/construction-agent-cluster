      "input": "text",
      "adminOnly": true
    },
    {
      "id": "check-outcomes",
      "label": "Check every outcome",
      "description": "Work out which outcomes are live, on demo data or waiting for a key",
      "input": null
    },
    {
      "id": "run-outcomes",
      "label": "Run my outcomes now",
      "description": "Run every outcome you have access to once and record the result",
      "input": null
    },
    {
      "id": "snapshot",
      "label": "Save a site map snapshot",
      "description": "Write the current state of every outcome to Reports",
      "input": null
    },
    {
      "id": "test-connections",
      "label": "Test every connection",
      "description": "Sign in to each outside service that has its keys and record the latency",
      "input": null,
      "adminOnly": true
    }
