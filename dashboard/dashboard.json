{
  "title": "Construction Agent",
  "tagline": "Site documents filed, contractor files mirrored, the project inbox triaged, every action on record.",
  "orb": {
    "headline": "Healthy",
    "metric": "Success rate",
    "value": "98%",
    "detail": ""
  },
  "ring": [
    {
      "label": "Runs today",
      "sample": "24"
    },
    {
      "label": "Success",
      "sample": "98%"
    },
    {
      "label": "Last run",
      "sample": "2m"
    }
  ],
  "metrics": [
    {
      "key": "runs",
      "label": "Runs today",
      "unit": "",
      "good": "up"
    },
    {
      "key": "success",
      "label": "Success rate",
      "unit": "%",
      "good": "up"
    },
    {
      "key": "errors",
      "label": "Errors",
      "unit": "",
      "good": "down"
    },
    {
      "key": "activeTasks",
      "label": "Working now",
      "unit": "",
      "good": "down"
    },
    {
      "key": "docsFiled",
      "label": "Documents filed",
      "unit": "",
      "good": "up"
    },
    {
      "key": "docsWaiting",
      "label": "Files waiting",
      "unit": "",
      "good": "down"
    },
    {
      "key": "ftpTransfers",
      "label": "Files transferred",
      "unit": "",
      "good": "up"
    },
    {
      "key": "ftpFailed",
      "label": "Transfer failures",
      "unit": "",
      "good": "down"
    },
    {
      "key": "emailsProcessed",
      "label": "Emails triaged",
      "unit": "",
      "good": "up"
    },
    {
      "key": "emailBacklog",
      "label": "Inbox backlog",
      "unit": "",
      "good": "down"
    },
    {
      "key": "logRows",
      "label": "Events on record",
      "unit": "",
      "good": "up"
    },
    {
      "key": "dbIntegrity",
      "label": "Record integrity",
      "unit": "%",
      "good": "up"
    }
  ],
  "panels": [
    {
      "title": "Activity",
      "kind": "line",
      "fields": [
        "Runs"
      ]
    },
    {
      "title": "Arrivals, last 24 hours",
      "kind": "line",
      "fields": [
        "Files"
      ]
    },
    {
      "title": "Recent arrivals",
      "kind": "table",
      "fields": [
        "File",
        "Folder",
        "Event",
        "When"
      ]
    },
    {
      "title": "Transfers, last 24 hours",
      "kind": "line",
      "fields": [
        "Transfers"
      ]
    },
    {
      "title": "Transfer history",
      "kind": "table",
      "fields": [
        "File",
        "Direction",
        "Result",
        "When"
      ]
    },
    {
      "title": "Triage by rule",
      "kind": "bar",
      "fields": [
        "Messages"
      ]
    },
    {
      "title": "Recent messages",
      "kind": "table",
      "fields": [
        "From",
        "Subject",
        "Result",
        "When"
      ]
    },
    {
      "title": "Events by source",
      "kind": "bar",
      "fields": [
        "Events"
      ]
    },
    {
      "title": "Latest events",
      "kind": "table",
      "fields": [
        "Source",
        "Result",
        "What",
        "When"
      ]
    }
  ],
  "actions": [
    {
      "id": "run",
      "label": "Run every outcome now",
      "description": "Scan the site folder, sync FTP and check the inbox once, for every outcome that is set up",
      "input": null,
      "adminOnly": true
    },
    {
      "id": "scan-folders",
      "label": "Scan site folders",
      "description": "Look for new drawings and documents now",
      "input": null
    },
    {
      "id": "sync-ftp",
      "label": "Sync FTP now",
      "description": "Mirror files with the contractor FTP server now",
      "input": null
    },
    {
      "id": "check-inbox",
      "label": "Check inbox now",
      "description": "Triage new project emails now",
      "input": null
    },
    {
      "id": "check-database",
      "label": "Check the record",
      "description": "Verify the activity record is intact",
      "input": null
    }
  ],
  "reports": [],
  "panes": [
    {
      "id": "documents",
      "title": "Site documents",
      "summary": "Drawings and documents filed the moment they land in the watched site folder.",
      "feature": "F2",
      "metrics": [
        "docsFiled",
        "docsWaiting"
      ],
      "panels": [
        "Arrivals, last 24 hours",
        "Recent arrivals"
      ],
      "actions": [
        "scan-folders"
      ],
      "client": true,
      "layout": "split",
      "columns": [
        "File",
        "Folder",
        "Event",
        "When"
      ],
      "recordsTitle": "Arrivals"
    },
    {
      "id": "transfers",
      "title": "Contractor file transfers",
      "summary": "Files mirrored between site and the contractor's FTP server, with every failure shown.",
      "feature": "F2",
      "metrics": [
        "ftpTransfers",
        "ftpFailed"
      ],
      "panels": [
        "Transfers, last 24 hours",
        "Transfer history"
      ],
      "actions": [
        "sync-ftp"
      ],
      "client": true,
      "layout": "focus",
      "columns": [
        "File",
        "Direction",
        "Result",
        "When"
      ],
      "recordsTitle": "Transfers"
    },
    {
      "id": "inbox",
      "title": "Project inbox",
      "summary": "RFIs and invoices picked out of the project mailbox by your triage rules.",
      "feature": "F2",
      "metrics": [
        "emailsProcessed",
        "emailBacklog"
      ],
      "panels": [
        "Triage by rule",
        "Recent messages"
      ],
      "actions": [
        "check-inbox"
      ],
      "client": true,
      "layout": "split",
      "columns": [
        "From",
        "Subject",
        "Result",
        "When"
      ],
      "recordsTitle": "Messages"
    },
    {
      "id": "activity-log",
      "title": "Activity record",
      "summary": "A permanent, filterable record of everything the agent has done, exportable on demand.",
      "feature": "F2",
      "metrics": [
        "logRows",
        "dbIntegrity"
      ],
      "panels": [
        "Events by source",
        "Latest events"
      ],
      "actions": [
        "check-database"
      ],
      "client": true,
      "layout": "grid",
      "columns": [
        "Source",
        "Result",
        "What",
        "When"
      ],
      "recordsTitle": "Events"
    }
  ],
  "settings": [
    {
      "key": "watch_folder",
      "label": "Watched site folder",
      "type": "text",
      "group": "Site folder",
      "help": "Absolute path of the folder where site documents arrive."
    },
    {
      "key": "ftp_host",
      "label": "FTP host",
      "type": "text",
      "group": "Contractor FTP",
      "help": "e.g. ftp.contractor.example"
    },
    {
      "key": "ftp_port",
      "label": "FTP port",
      "type": "number",
      "default": 21,
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_user",
      "label": "FTP user",
      "type": "text",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_password",
      "label": "FTP password",
      "type": "secret",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_secure",
      "label": "FTP security",
      "type": "select",
      "options": [
        "none",
        "explicit",
        "implicit"
      ],
      "default": "explicit",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_remote_dir",
      "label": "FTP remote folder",
      "type": "text",
      "default": "/",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_local_dir",
      "label": "Local mirror folder",
      "type": "text",
      "group": "Contractor FTP",
      "help": "Where mirrored files are kept. Leave empty to use the dashboard data folder."
    },
    {
      "key": "ftp_direction",
      "label": "Sync direction",
      "type": "select",
      "options": [
        "download",
        "upload",
        "both"
      ],
      "default": "download",
      "group": "Contractor FTP"
    },
    {
      "key": "imap_host",
      "label": "Mailbox host (IMAP)",
      "type": "text",
      "group": "Project mailbox",
      "help": "e.g. imap.example.com"
    },
    {
      "key": "imap_port",
      "label": "Mailbox port",
      "type": "number",
      "default": 993,
      "group": "Project mailbox"
    },
    {
      "key": "imap_user",
      "label": "Mailbox user",
      "type": "text",
      "group": "Project mailbox"
    },
    {
      "key": "imap_password",
      "label": "Mailbox password",
      "type": "secret",
      "group": "Project mailbox"
    },
    {
      "key": "imap_secure",
      "label": "Use TLS",
      "type": "toggle",
      "default": true,
      "group": "Project mailbox"
    },
    {
      "key": "imap_mailbox",
      "label": "Mailbox folder",
      "type": "text",
      "default": "INBOX",
      "group": "Project mailbox"
    },
    {
      "key": "imap_rules",
      "label": "Triage rules",
      "type": "textarea",
      "group": "Project mailbox",
      "help": "One rule per line as name: subject keyword, e.g. rfi: RFI"
    },
    {
      "key": "staleAfterMin",
      "label": "Flag a monitor as stale after (min)",
      "type": "number",
      "default": 30,
      "group": "Monitoring"
    },
    {
      "key": "recentRows",
      "label": "Rows shown in recent lists",
      "type": "number",
      "default": 12,
      "group": "Monitoring"
    },
    {
      "key": "successTarget",
      "label": "Sync success target (%)",
      "type": "number",
      "default": 90,
      "group": "Monitoring"
    },
    {
      "key": "latencyWarnMs",
      "label": "Flag a service as slow above (ms)",
      "type": "number",
      "default": 1500,
      "group": "Monitoring"
    }
  ],
  "connections": [
    {
      "id": "folders",
      "name": "Site folder",
      "summary": "The local folder the agent watches for new site documents.",
      "docs": "",
      "required": true,
      "fields": [
        "watch_folder"
      ]
    },
    {
      "id": "ftp",
      "name": "Contractor FTP server",
      "summary": "FTP or FTPS server mirrored with the site.",
      "docs": "https://www.rfc-editor.org/rfc/rfc959",
      "required": true,
      "fields": [
        "ftp_host",
        "ftp_user",
        "ftp_password"
      ],
      "optional": [
        "ftp_port",
        "ftp_secure",
        "ftp_remote_dir",
        "ftp_local_dir",
        "ftp_direction"
      ]
    },
    {
      "id": "imap",
      "name": "Project mailbox (IMAP)",
      "summary": "The inbox the agent triages for RFIs and invoices.",
      "docs": "https://www.rfc-editor.org/rfc/rfc9051",
      "required": true,
      "fields": [
        "imap_host",
        "imap_user",
        "imap_password"
      ],
      "optional": [
        "imap_port",
        "imap_secure",
        "imap_mailbox",
        "imap_rules"
      ]
    }
  ],
  "repo": "construction-agent-cluster",
  "port": 4102
}
