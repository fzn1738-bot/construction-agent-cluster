    },
    {
      "title": "Arrivals, last 24 hours",
      "kind": "line",
      "fields": [
        "Files"
      ]
    },
    {
      "title": "Recent arrivals",
      "kind": "table",
      "fields": [
        "File",
        "Folder",
        "Event",
        "When"
      ]
    },
    {
      "title": "Transfers, last 24 hours",
      "kind": "line",
      "fields": [
        "Transfers"
      ]
    },
    {
      "title": "Transfer history",
      "kind": "table",
      "fields": [
        "File",
