  "settings": [
    {
      "key": "watch_folder",
      "label": "Watched site folder",
      "type": "text",
      "group": "Site folder",
      "help": "Absolute path of the folder where site documents arrive."
    },
    {
      "key": "ftp_host",
      "label": "FTP host",
      "type": "text",
      "group": "Contractor FTP",
      "help": "e.g. ftp.contractor.example"
    },
    {
      "key": "ftp_port",
      "label": "FTP port",
      "type": "number",
      "default": 21,
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_user",
      "label": "FTP user",
      "type": "text",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_password",
      "label": "FTP password",
      "type": "secret",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_secure",
      "label": "FTP security",
      "type": "select",
      "options": [
        "none",
        "explicit",
        "implicit"
      ],
      "default": "explicit",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_remote_dir",
      "label": "FTP remote folder",
      "type": "text",
      "default": "/",
      "group": "Contractor FTP"
    },
    {
      "key": "ftp_local_dir",
      "label": "Local mirror folder",
      "type": "text",
      "group": "Contractor FTP",
      "help": "Where mirrored files are kept. Leave empty to use the dashboard data folder."
    },
    {
      "key": "ftp_direction",
      "label": "Sync direction",
      "type": "select",
      "options": [
        "download",
        "upload",
        "both"
      ],
      "default": "download",
      "group": "Contractor FTP"
    },
    {
